{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start You Sushi app",
			"type": "shell",
			"command": "npm run dev -- --host 127.0.0.1",
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Build You Sushi app",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Serve You Sushi app",
			"type": "shell",
			"command": "npx vite --host 127.0.0.1 --port 5174",
			"isBackground": true,
			"group": "build"
		}
	]
}